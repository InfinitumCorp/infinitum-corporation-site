# Copy to .dev.vars for `wrangler pages dev`, or set in Cloudflare Pages -> Settings -> Variables and Secrets.
# Optional. Without ANTHROPIC_API_KEY the app runs in demo mode with simulated agent output.
ANTHROPIC_API_KEY=
# Optional model override
SCALVS_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=
SCALVS_WEB_SEARCH=on

# Optional: cloud sync (see supabase/migrations)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: server-side daily limits for live agent runs (see README)
SCALVS_DAILY_LIMIT_USER=100
SCALVS_DAILY_LIMIT_ANON=10
SCALVS_DAILY_LIMIT_GLOBAL=1000
SCALVS_REQUIRE_SIGNIN=false
