{
  "manifest_version": 3,
  "name": "SCALVS.ai™",
  "short_name": "SCALVS.ai",
  "version": "0.1.0",
  "description": "Ask SCALVS.ai from any page: chat in the side panel, or send the selection or the current page to it.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "SCALVS.ai",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": { "default_path": "src/panel.html" },
  "options_page": "src/options.html",
  "background": { "service_worker": "src/background.js", "type": "module" },
  "permissions": ["sidePanel", "contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://scalvs-ai.infinitumcorp.workers.dev/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"]
}
